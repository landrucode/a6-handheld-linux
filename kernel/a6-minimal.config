# Minimal ARMv7 baseline for the first N42AP Linux image.
# This is a fragment consumed after tinyconfig; it is not a complete defconfig.

CONFIG_COMPILE_TEST=y
CONFIG_MMU=y
CONFIG_ARCH_MULTIPLATFORM=y
CONFIG_ARCH_MULTI_V7=y
CONFIG_CPU_V7=y
CONFIG_NR_CPUS=1
# CONFIG_SMP is not set
CONFIG_GENERIC_IRQ_CHIP=y
CONFIG_GENERIC_CLOCKEVENTS=y
CONFIG_CLKSRC_OF=y

CONFIG_USE_OF=y
CONFIG_OF=y
CONFIG_ARM_APPENDED_DTB=y
# CONFIG_ARM_ATAG_DTB_COMPAT is not set

CONFIG_KERNEL_GZIP=y
# CONFIG_KERNEL_XZ is not set
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_CORE_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_SAMSUNG=y
CONFIG_SERIAL_SAMSUNG_CONSOLE=y
CONFIG_SERIAL_SAMSUNG_UARTS=4

CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="earlycon=apple,s5l-uart,0x32600000 console=ttySAC0,115200 loglevel=8 panic=0 lpj=1000000"
CONFIG_CMDLINE_FORCE=y
