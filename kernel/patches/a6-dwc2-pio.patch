--- a/drivers/usb/dwc2/params.c
+++ b/drivers/usb/dwc2/params.c
@@ -306,1 +306,25 @@
+/* N42 bring-up: keep DMA/cache coherency and power transitions out of scope. */
+static void dwc2_set_a6_params(struct dwc2_hsotg *hsotg)
+{
+	struct dwc2_core_params *p = &hsotg->params;
+	int i;
+
+	p->g_dma = false;
+	p->g_dma_desc = false;
+	p->otg_caps.hnp_support = false;
+	p->otg_caps.srp_support = false;
+	p->lpm = false;
+	p->lpm_clock_gating = false;
+	p->besl = false;
+	p->hird_threshold_en = false;
+	p->power_down = DWC2_POWER_DOWN_PARAM_NONE;
+	p->phy_type = DWC2_PHY_TYPE_PARAM_UTMI;
+	p->phy_utmi_width = 16;
+	p->g_rx_fifo_size = 512;
+	p->g_np_tx_fifo_size = 128;
+	for (i = 1; i < ARRAY_SIZE(p->g_tx_fifo_size); i++)
+		p->g_tx_fifo_size[i] = 128;
+}
+
 const struct of_device_id dwc2_of_match_table[] = {
+	{ .compatible = "apple,s5l8950-dwc2", .data = dwc2_set_a6_params },
