#!/usr/bin/env bash
# USB-only Arch shell. Host key is enrolled through the verified serial link.
set -euo pipefail
repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
[[ -f "$repo_root/build/ssh/a6_ed25519" && -s "$repo_root/build/ssh/known_hosts" ]] || {
    echo 'Missing project SSH identity or serial-verified phone host key under build/ssh/.' >&2
    exit 1
}
exec ssh -F /dev/null -i "$repo_root/build/ssh/a6_ed25519" \
    -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=yes \
    -o UserKnownHostsFile="$repo_root/build/ssh/known_hosts" \
    -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=2 \
    -p 2222 root@192.168.7.2 "$@"
